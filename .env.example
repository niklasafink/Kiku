# --- AI (required) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Any OpenRouter model id works; the transcription model must accept audio input.
# GRADING_MODEL=openai/gpt-6-luna
# TRANSCRIBE_MODEL=google/gemini-3.8-flash
# The study tandem: the model that talks (default: the grading model) and the text-to-speech model that voices it.
# TANDEM_MODEL=openai/gpt-6-luna
# SPEECH_MODEL=elevenlabs/eleven-v4-turbo

# --- Accounts, sync and MCP (optional) ---
# Leave these three empty to run as a local-only app without login.
# Set all three to turn on user accounts, sync between devices and the MCP endpoint.

# Postgres connection string of your Neon project (pooled connection).
DATABASE_URL=

# Auth URL of the Neon branch (Neon console -> Auth), e.g.
# https://ep-xxx.neonauth.eu-central-1.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=

# Any random string of 32+ characters. Generate one with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Comma-separated e-mail addresses of paid accounts. Everyone else is on the free plan: speech is
# transcribed by the browser, grading uses free models and then a very cheap one.
PAID_EMAILS=
# Comma-separated e-mail addresses of accounts with everything of the paid plan and no limits at all.
UNLIMITED_EMAILS=
# Optional. Models that grade for the free plan, tried in order.
# FREE_PLAN_GRADING_MODELS=nvidia/nemotron-3-super-120b-a12b:free,dots-studio/dots-3-note-preview:free,inclusionai/ling-3.0-flash-vl

# --- Sign-up notifications (optional) ---
# Set both to get a Telegram message whenever someone creates an account.
# Token from @BotFather; chat id of the chat the bot should write to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
