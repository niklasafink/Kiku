# --- AI (required) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Any OpenRouter model id works; the transcription model must accept audio input.
# GRADING_MODEL=openai/gpt-6-luna
# TRANSCRIBE_MODEL=google/gemini-3.8-flash

# --- Accounts, sync and MCP (optional) ---
# Leave these three empty to run as a local-only app without login.
# Set all three to turn on user accounts, sync between devices and the MCP endpoint.

# Postgres connection string of your Neon project (pooled connection).
DATABASE_URL=

# Auth URL of the Neon branch (Neon console -> Auth), e.g.
# https://ep-xxx.neonauth.eu-central-1.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=

# Any random string of 32+ characters. Generate one with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# --- Sign-up notifications (optional) ---
# Set both to get a Telegram message whenever someone creates an account.
# Token from @BotFather; chat id of the chat the bot should write to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
